# ScoutMatch – lokale Entwicklungsumgebung
# Kopiere diese Datei zu ".env" und trage lokale Werte ein.
# NIEMALS echte Secrets hier oder in .env ins Repository committen.

# Zufälligen, langen Wert erzeugen z. B. mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Nur für lokale Entwicklung. In Produktion würde hier ein echter, separat
# verwalteter Wert stehen – wird hier bewusst NICHT vorbereitet, da die
# Seite laut Vorgabe nicht veröffentlicht werden soll.
FLASK_ENV=development
PORT=5001

# SQLite-Datei (relativer Pfad zum Projektverzeichnis)
DATABASE_PATH=instance/scoutmatch.db

# Maximale Upload-Größe für Profilbilder in Bytes (hier: 5 MB)
MAX_UPLOAD_BYTES=5242880

# Nur bei echtem Betrieb über https:// auf "true" setzen (siehe README,
# Abschnitt "Production Deployment"). Lokal über http:// muss dies "false"
# bleiben, sonst verwirft der Browser das Session-Cookie.
SESSION_COOKIE_SECURE=false
